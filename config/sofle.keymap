#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/modifiers.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define LOWER 1
#define RAISE 2
#define ADJUST 3

/ {
    // Activate ADJUST layer by pressing raise and lower

    combos {
        compatible = "zmk,combos";

        keys {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <15 16>;
        };

        parenthesis {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <27 28>;
        };

        brac {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <39 40>;
        };
    };

    behaviors {
        hrm_shift: hrm_shift {
            compatible = "zmk,behavior-hold-tap";
            label = "HRM_SHIFT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
        };

        hrm_ctrl: hrm_ctrl {
            compatible = "zmk,behavior-hold-tap";
            label = "HRM_CTRL";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
        };

        ctrl_tab: ctrl_tab {
            compatible = "zmk,behavior-mod-morph";
            label = "CTRL_TAB";
            #binding-cells = <0>;
            bindings = <&kp TAB>, <&kp LA(TAB)>;
            mods = <(MOD_LCTL)>;
            keep-mods = <(MOD_LCTL)>;
        };

        tilda: tilda {
            compatible = "zmk,behavior-hold-tap";
            label = "TILDA";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
        };
    };

    macros {
        mac_profile: mac_profile {
            compatible = "zmk,behavior-macro";
            label = "MAC_PROFILE";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1>, <&to 3>;
        };

        win_profile: win_profile {
            compatible = "zmk,behavior-macro";
            label = "WIN_PROFILE";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0>, <&to 0>;
        };

        iphone_profile: iphone_profile {
            compatible = "zmk,behavior-macro";
            label = "IPHONE_PROFILE";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 2>, <&to 3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        win {
            display-name = "default";

            // ------------------------------------------------------------------------------------------------------------
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |       |
            // |  ESC  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   | BKSPC |
            // |  TAB  |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |  MUTE  |  |       |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //               | GUI | ALT  | CTRL | LOWER|  ENTER |  | ENTER | SPACE| LOWER | RAISE | GUI  |

            bindings = <
&trans     &kp NUMBER_1  &kp NUMBER_2  &kp N3            &kp N4                   &kp N5                              &kp NUMBER_6  &kp NUMBER_7              &kp NUMBER_8           &kp NUMBER_9  &kp NUMBER_0  &trans
&kp ESC    &kp Q         &kp W         &kp E             &kp R                    &kp T                               &kp Y         &kp U                     &kp I                  &kp O         &kp P         &kp BSPC
&ctrl_tab  &kp A         &kp S         &hrm_ctrl LGUI D  &hrm_shift LEFT_SHIFT F  &kp G                               &kp H         &hrm_shift RIGHT_SHIFT J  &hrm_ctrl RIGHT_GUI K  &kp L         &kp SEMI      &tilda TILDE SQT
&kp LSHFT  &kp Z         &kp X         &kp C             &kp V                    &kp B      &kp C_MUTE    &none      &kp N         &kp M                     &kp COMMA              &kp DOT       &kp FSLH      &trans
                            &trans        &trans            &kp LCTRL             &kp SPACE  &kp RET      &kp ENTER  &kp SPACE     &mo 1                     &mo 2                  &mo 4
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        utils {
            display-name = "lower";

            // TODO: Some binds are waiting for shifted keycode support.
            // ------------------------------------------------------------------------------------------------------------
            // |       |  F1 |  F2 |  F3  |  F4  |  F5  |                   |  F6  |  F7   |  F8   |  F9  |  F10  |  F11  |
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |  F12  |
            // |       |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   |   |
            // |       |  =  |  -  |  +   |  {   |  }   |        |  |       |  [   |  ]    |  ;    |  :   |   \   |       |
            //               |     |      |      |      |        |  |       |      |       |       |      |

            bindings = <
&trans     &trans     &trans     &trans    &trans     &trans                       &trans     &trans    &trans    &trans   &trans  &trans
&kp GRAVE  &kp EQUAL  &kp MINUS  &kp PLUS  &kp COLON  &kp SLASH                    &trans     &kp LPAR  &kp RPAR  &trans   &trans  &trans
&trans     &kp EXCL   &kp AT     &kp HASH  &kp DLLR   &kp PRCNT                    &kp CARET  &kp LBRC  &kp RBRC  &kp SQT  &trans  &trans
&trans     &trans     &trans     &trans    &trans     &trans     &trans    &trans  &trans     &kp LBKT  &kp RBKT  &trans   &trans  &trans
                      &trans     &trans    &trans     &trans     &trans    &trans  &trans     &trans    &trans    &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        adjust {
            display-name = "raise";

            // ------------------------------------------------------------------------------------------------------------
            // | BTCLR | BT1  | BT2  |  BT3  |  BT4  |  BT5 |                |      |      |       |      |       |       |
            // |       | INS  | PSCR | GUI   |       |      |                | PGUP |      |   ^   |      |       |       |
            // |       | ALT  | CTRL | SHIFT |       | CAPS |                | PGDN |   <- |   v   |  ->  |  DEL  | BKSPC |
            // |       | UNDO | CUT  | COPY  | PASTE |      |      |  |      |      |      |       |      |       |       |
            //                |      |       |       |      |      |  |      |      |      |       |      |

            bindings = <
&bt BT_CLR      &win_profile  &mac_profile &iphone_profile &bt BT_SEL 3  &bt BT_SEL 4                    &trans     &trans    &trans    &trans     &trans   &trans
&bt BT_CLR_ALL  &kp INS       &kp PSCRN     &kp K_CMENU   &trans        &trans                          &kp PG_UP  &trans    &kp UP    &trans     &kp N0   &trans
&trans          &kp LALT      &kp LCTRL     &kp LSHFT     &trans        &kp CLCK                        &kp PG_DN  &kp LEFT  &kp DOWN  &kp RIGHT  &kp DEL  &kp BSPC
&trans          &kp K_UNDO    &kp K_CUT     &kp K_COPY    &kp K_PASTE   &trans        &trans    &trans  &trans     &trans    &trans    &trans     &trans   &trans
                              &trans        &trans        &trans        &trans        &trans    &trans  &trans     &trans    &trans    &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        mac {
            display-name = "mac";

            // ------------------------------------------------------------------------------------------------------------
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |       |
            // |  ESC  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   | BKSPC |
            // |  TAB  |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |  MUTE  |  |       |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //               | GUI | ALT  | CMD  | LOWER |  ENTER |  | ENTER | SPACE | LOWER | RAISE   | GUI  |
            //
            // Overlay: só a tecla CTRL do polegar esquerdo vira CMD. Todo o resto herda da camada default (win).

            bindings = <
&trans     &trans  &trans  &trans            &trans                   &trans                              &trans  &trans              &trans           &trans  &trans  &trans
&trans     &trans  &trans  &trans            &trans                   &trans                              &trans  &trans              &trans           &trans  &trans  &trans
&trans     &trans  &trans  &trans            &trans                   &trans                              &trans  &trans              &trans           &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                            &trans        &trans            &kp LGUI                &trans  &trans      &trans  &trans     &trans                     &trans                  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        mouse {
            display-name = "mouse";

            // Camada do mouse (segure o GUI do dedão direito).
            // W/A/S/D rolam a tela. SPACE e RET do dedão esquerdo são clique esquerdo e direito.

            bindings = <
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &msc SCRL_UP &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &msc SCRL_LEFT &msc SCRL_DOWN &msc SCRL_RIGHT &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &mkp LCLK &mkp RCLK &trans &trans &trans &trans &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };
    };
};



            
  